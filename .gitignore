# ─────────────────────────────────────────────────────────────────────────────
# ict_tier_v2 .gitignore
# Purpose: ignore garbage (caches, build artifacts, OS junk) and large data
# while keeping the small data slices used by tests + smoke tests tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
.installed.cfg
*.egg-info
MANIFEST

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Testing / pytest / coverage ──────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/
htmlcov/

# ── Jupyter notebooks (build artifacts) ──────────────────────────────────────
# Source of truth is the .py script (Jupytext percent format).
# The .ipynb files are regenerated by `jupytext --to notebook` and
# `jupyter nbconvert --execute`. See AGENTS.md "Notebook workflow".
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── IDE / editor junk ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Data ─────────────────────────────────────────────────────────────────────
# The 1y corpus is 617MB and not used in tests; ignore it.
# The 1d slice and 5k-bar sample ARE tracked (referenced by README + tests).
data/XAUUSD_S1_1y.parquet

# ── Graphify output (local knowledge-graph cache) ────────────────────────────
graphify-out/

# ── Logs and large run artifacts (CSVs stay tracked — they're deliverables) ──
# Keep *.csv under notebooks/ tracked. Ignore log noise and checkpoints.
*.log
logs/
*.tmp
*.bak

# ── OS-specific ──────────────────────────────────────────────────────────────
# Windows
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userprefs

# macOS
._*
.Spotlight-V100
.Trashes
.fseventsd

# ── Misc ─────────────────────────────────────────────────────────────────────
*.swp
*.swo
*.orig
*.rej
*.tgz
*.tar.gz
*.zip
*.rar
*.7z
*.dmg

# ── Live-engine deployment (added 2026-09-18) ────────────────────────────────
# Local .env files hold Binance API credentials; never commit.
.env
.env.local
.env.*.local

# Terraform / Ansible state and secrets.
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfvars
deploy/terraform/*.tfvars.json
deploy/terraform/lightsail_key.pem
deploy/terraform/*.pem
deploy/terraform/.terraform.lock.hcl
deploy/terraform/plan.tf
deploy/terraform/crash.log
deploy/terraform/crash.*.log
deploy/ansible/inventory
deploy/ansible/.vault-password

# Live engine state directory on the VPS — never tracked.
/var/lib/ict-sniper/
deploy/var/lib/ict-sniper/

# Live engine log directory on the VPS — never tracked.
deploy/var/log/ict-sniper/

# Live engine backups (sqlite snapshots are large; produced nightly by the
# observability cron). Not in git; if you want offline backups wire S3.
deploy/var/lib/ict-sniper/backups/

# Any local state.db files that escape onto a dev box.
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
